{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-creator.local/schemas/script-input.schema.json",
  "title": "VideoCreator WeChat Channels script input",
  "type": "object",
  "required": ["schema_version", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "target_duration_seconds": {
      "description": "Requested video duration; defaults to 60 seconds when omitted.",
      "type": "integer",
      "minimum": 45,
      "maximum": 90
    },
    "sections": {
      "type": "object",
      "required": ["hook", "problem", "evidence", "comparison", "conclusion", "cta"],
      "properties": {
        "hook": { "$ref": "#/$defs/hookSection" },
        "problem": { "$ref": "#/$defs/compressibleSection" },
        "evidence": {
          "allOf": [
            { "$ref": "#/$defs/section" },
            { "type": "object", "properties": { "source_ids": { "minItems": 1 } } }
          ]
        },
        "comparison": { "$ref": "#/$defs/compressibleSection" },
        "conclusion": { "$ref": "#/$defs/compressibleSection" },
        "cta": { "$ref": "#/$defs/section" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hookSection": {
      "type": "object",
      "required": ["narration", "source_ids", "hook_type"],
      "properties": {
        "narration": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^S[0-9]{3,}$" }
        },
        "hook_type": {
          "description": "The type of message delivered in the opening three seconds.",
          "enum": ["conclusion", "counterintuitive", "conflict"]
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["narration", "source_ids"],
      "properties": {
        "narration": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^S[0-9]{3,}$" }
        }
      },
      "additionalProperties": false
    },
    "compressibleSection": {
      "type": "object",
      "required": ["narration", "source_ids"],
      "properties": {
        "narration": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^S[0-9]{3,}$" }
        },
        "optional_sentences": {
          "description": "Complete, non-essential sentences that may be removed to meet the target duration.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
