{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["asset_id", "scene_id", "type", "path", "source", "license", "generated", "provider"],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^A[0-9]{3,}$" },
        "scene_id": { "type": "string", "pattern": "^SC[0-9]{3,}$" },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "generated": { "type": "boolean" },
        "provider": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
