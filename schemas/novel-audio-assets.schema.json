{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-audio-assets.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "animatic_revision", "revision", "created_at", "updated_at", "tracks", "cues", "mix_profile"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "animatic_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}}, "cues": {"type": "array", "items": {"$ref": "#/$defs/cue"}}, "mix_profile": {"$ref": "#/$defs/mix"}},
  "$defs": {"review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "reviewed_at", "reviewed_by", "note"], "properties": {"required": {"const": true}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}}}, "track": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "source_kind", "license_status", "status", "human_review"], "properties": {"id": {"type": "string", "pattern": "^AUDIO-[A-Z0-9-]+$"}, "kind": {"enum": ["MUSIC", "AMBIENCE", "SFX"]}, "path": {"type": ["string", "null"]}, "source_kind": {"enum": ["LOCAL", "ORIGINAL", "PROVIDER"]}, "license_status": {"enum": ["UNKNOWN", "CLEARED", "RESTRICTED"]}, "status": {"enum": ["PLANNED", "READY"]}, "human_review": {"$ref": "#/$defs/review"}}}, "cue": {"type": "object", "additionalProperties": false, "required": ["id", "episode_id", "track_id", "start_seconds", "duration_seconds", "mix_note"], "properties": {"id": {"type": "string", "pattern": "^ACUE-[A-Z0-9-]+$"}, "episode_id": {"type": "string"}, "track_id": {"type": "string"}, "start_seconds": {"type": "number", "minimum": 0}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "mix_note": {"type": "string"}}}, "mix": {"type": "object", "additionalProperties": false, "required": ["target_lufs", "true_peak_db", "dialogue_ducking_db", "sample_rate"], "properties": {"target_lufs": {"type": "number"}, "true_peak_db": {"type": "number"}, "dialogue_ducking_db": {"type": "number"}, "sample_rate": {"type": "integer", "enum": [44100, 48000]}}}}
}
