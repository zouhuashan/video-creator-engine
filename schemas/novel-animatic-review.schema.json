{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-animatic-review.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "animatic_revision", "shot_breakdown_revision", "storyboard_revision", "revision", "created_at", "updated_at", "overall_status", "findings", "human_review"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "animatic_revision": {"type": "integer", "minimum": 1}, "shot_breakdown_revision": {"type": "integer", "minimum": 1}, "storyboard_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "overall_status": {"enum": ["PASS", "BLOCKED"]}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "human_review": {"$ref": "#/$defs/review"}},
  "$defs": {"finding": {"type": "object", "additionalProperties": false, "required": ["id", "category", "severity", "entity_id", "message", "status"], "properties": {"id": {"type": "string", "pattern": "^ANIMF-[A-Z0-9-]+$"}, "category": {"enum": ["RHYTHM", "ACTION_READABILITY", "CHARACTER_CONTINUITY", "ENVIRONMENT_CONTINUITY", "PROP_CONTINUITY"]}, "severity": {"enum": ["BLOCKER", "WARNING"]}, "entity_id": {"type": "string"}, "message": {"type": "string"}, "status": {"enum": ["OPEN", "RESOLVED"]}}}, "review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "reviewed_at", "reviewed_by", "note"], "properties": {"required": {"const": true}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}}}}
}
