{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-asset-review.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "visual_bible_revision", "environment_assets_revision", "revision", "created_at", "updated_at", "reference_packages", "selection_records", "art_reviews"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "visual_bible_revision": {"type": "integer", "minimum": 1}, "environment_assets_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "reference_packages": {"type": "array", "items": {"$ref": "#/$defs/package"}}, "selection_records": {"type": "array", "items": {"$ref": "#/$defs/selection"}}, "art_reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}}},
  "$defs": {
    "reference": {"type": "object", "additionalProperties": false, "required": ["id", "view", "asset_id", "version", "role", "status", "continuity_signature"], "properties": {"id": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}, "view": {"type": "string"}, "asset_id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "role": {"enum": ["IDENTITY", "POSE", "ENVIRONMENT", "PROP", "COLOR", "KEYFRAME"]}, "status": {"enum": ["CANDIDATE", "SELECTED", "REJECTED"]}, "continuity_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "package": {"type": "object", "additionalProperties": false, "required": ["id", "entity_id", "entity_type", "purpose", "references", "selected_reference_ids", "human_review"], "properties": {"id": {"type": "string", "pattern": "^REFPACK-[A-Z0-9-]+$"}, "entity_id": {"type": "string"}, "entity_type": {"enum": ["character", "location", "prop", "shot", "episode"]}, "purpose": {"type": "string"}, "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}, "selected_reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "human_review": {"$ref": "#/$defs/review"}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["id", "reference_id", "asset_id", "version", "selected_at", "selected_by", "reason", "status"], "properties": {"id": {"type": "string", "pattern": "^ASSEL-[A-Z0-9-]+$"}, "reference_id": {"type": "string"}, "asset_id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "selected_at": {"type": "string", "format": "date-time"}, "selected_by": {"type": "string"}, "reason": {"type": "string"}, "status": {"enum": ["SELECTED", "REVOKED"]}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["id", "target_type", "target_id", "status", "reviewed_at", "reviewed_by", "note", "blocking_findings"], "properties": {"id": {"type": "string", "pattern": "^ARTREV-[A-Z0-9-]+$"}, "target_type": {"enum": ["REFERENCE_PACKAGE", "SELECTION"]}, "target_id": {"type": "string"}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}, "blocking_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
