{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-visual-bible.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "story_bible_revision", "script_package_revision", "revision", "created_at", "updated_at", "style", "color_script", "composition", "negative_constraints"],
  "properties": {
    "schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "story_bible_revision": {"type": "integer", "minimum": 1}, "script_package_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
    "style": {"$ref": "#/$defs/style"}, "color_script": {"$ref": "#/$defs/color_script"}, "composition": {"$ref": "#/$defs/composition"}, "negative_constraints": {"$ref": "#/$defs/negative_constraints"}
  },
  "$defs": {
    "review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "reviewed_at", "reviewed_by", "note"], "properties": {"required": {"const": true}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "source_refs", "story_refs", "note"], "properties": {"kind": {"enum": ["UNSET", "SOURCE", "ORIGINAL"]}, "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "story_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "note": {"type": "string"}}},
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "title", "art_direction", "cultural_basis", "linework", "rendering", "texture", "character_language", "environment_language", "motion_language", "prompt_prefix", "reference_asset_ids", "provenance", "human_review"],
      "properties": {"id": {"type": "string", "pattern": "^VSTYLE-[A-Z0-9]{2,12}-[0-9]{2}$"}, "status": {"enum": ["DRAFT", "READY"]}, "title": {"type": "string", "minLength": 1}, "art_direction": {"type": "string"}, "cultural_basis": {"type": "array", "items": {"type": "string"}}, "linework": {"type": "string"}, "rendering": {"type": "string"}, "texture": {"type": "string"}, "character_language": {"type": "string"}, "environment_language": {"type": "string"}, "motion_language": {"type": "string"}, "prompt_prefix": {"type": "string"}, "reference_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "provenance": {"$ref": "#/$defs/provenance"}, "human_review": {"$ref": "#/$defs/review"}}
    },
    "swatch": {"type": "object", "additionalProperties": false, "required": ["id", "name", "hex", "role"], "properties": {"id": {"type": "string", "pattern": "^COLOR-[A-Z0-9-]+$"}, "name": {"type": "string", "minLength": 1}, "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}, "role": {"type": "string"}}},
    "episode_palette": {"type": "object", "additionalProperties": false, "required": ["episode_id", "mood", "time_of_day", "lighting", "swatch_ids", "transition_note"], "properties": {"episode_id": {"type": "string"}, "mood": {"type": "string"}, "time_of_day": {"type": "string"}, "lighting": {"type": "string"}, "swatch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "transition_note": {"type": "string"}}},
    "color_script": {"type": "object", "additionalProperties": false, "required": ["status", "swatches", "episode_palettes", "human_review"], "properties": {"status": {"enum": ["DRAFT", "READY"]}, "swatches": {"type": "array", "items": {"$ref": "#/$defs/swatch"}}, "episode_palettes": {"type": "array", "items": {"$ref": "#/$defs/episode_palette"}}, "human_review": {"$ref": "#/$defs/review"}}},
    "safe_zone": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "number", "minimum": 0, "maximum": 0.95}, "right": {"type": "number", "minimum": 0, "maximum": 0.95}, "bottom": {"type": "number", "minimum": 0, "maximum": 0.95}, "left": {"type": "number", "minimum": 0, "maximum": 0.95}}},
    "composition_rule": {"type": "object", "additionalProperties": false, "required": ["id", "name", "rule", "applies_to"], "properties": {"id": {"type": "string", "pattern": "^COMPRULE-[A-Z0-9-]+$"}, "name": {"type": "string"}, "rule": {"type": "string"}, "applies_to": {"type": "array", "items": {"enum": ["CHARACTER", "LOCATION", "ACTION", "DIALOGUE", "TEXT", "TRANSITION"]}}}},
    "composition": {"type": "object", "additionalProperties": false, "required": ["status", "canvas", "safe_zone", "subtitle_zone", "rules", "human_review"], "properties": {"status": {"enum": ["DRAFT", "READY"]}, "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "aspect_ratio", "fps"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "aspect_ratio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}, "fps": {"type": "number", "exclusiveMinimum": 0}}}, "safe_zone": {"$ref": "#/$defs/safe_zone"}, "subtitle_zone": {"$ref": "#/$defs/safe_zone"}, "rules": {"type": "array", "items": {"$ref": "#/$defs/composition_rule"}}, "human_review": {"$ref": "#/$defs/review"}}},
    "negative_constraints": {"type": "object", "additionalProperties": false, "required": ["status", "global", "character_identity", "environment", "prompt_tokens", "forbidden_reference_types", "human_review"], "properties": {"status": {"enum": ["DRAFT", "READY"]}, "global": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "character_identity": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "environment": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "prompt_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "forbidden_reference_types": {"type": "array", "uniqueItems": true, "items": {"enum": ["MODERN_ANNOTATION", "MODERN_ILLUSTRATION", "EXISTING_SCREEN_DESIGN", "UNLICENSED_REFERENCE", "EMBEDDED_CREDENTIAL"]}}, "human_review": {"$ref": "#/$defs/review"}}}
  }
}
