{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-environment-assets.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "story_bible_revision", "visual_bible_revision", "revision", "created_at", "updated_at", "location_designs", "prop_designs", "scene_environment_assignments"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "story_bible_revision": {"type": "integer", "minimum": 1}, "visual_bible_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "location_designs": {"type": "array", "items": {"$ref": "#/$defs/location"}}, "prop_designs": {"type": "array", "items": {"$ref": "#/$defs/prop"}}, "scene_environment_assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}}},
  "$defs": {
    "review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "reviewed_at", "reviewed_by", "note"], "properties": {"required": {"const": true}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}}},
    "camera": {"type": "object", "additionalProperties": false, "required": ["id", "name", "description", "status", "asset_id", "continuity_signature"], "properties": {"id": {"type": "string", "pattern": "^CAMVIEW-[A-Z0-9-]+$"}, "name": {"type": "string"}, "description": {"type": "string"}, "status": {"enum": ["PLANNED", "GENERATED", "SELECTED", "REJECTED"]}, "asset_id": {"type": ["string", "null"]}, "continuity_signature": {"type": "string"}}},
    "variant": {"type": "object", "additionalProperties": false, "required": ["id", "weather", "time_of_day", "lighting", "season", "palette_swatch_ids", "status", "asset_id", "continuity_signature", "continuity_note"], "properties": {"id": {"type": "string", "pattern": "^LVAR-[A-Z0-9-]+$"}, "weather": {"type": "string"}, "time_of_day": {"type": "string"}, "lighting": {"type": "string"}, "season": {"type": "string"}, "palette_swatch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "status": {"enum": ["PLANNED", "GENERATED", "SELECTED", "REJECTED"]}, "asset_id": {"type": ["string", "null"]}, "continuity_signature": {"type": "string"}, "continuity_note": {"type": "string"}}},
    "location": {"type": "object", "additionalProperties": false, "required": ["id", "location_id", "status", "layout", "visual_language", "base_palette_swatch_ids", "continuity_signature", "camera_views", "variants", "prompt_template", "human_review"], "properties": {"id": {"type": "string", "pattern": "^LDES-LOCN-[A-Z0-9-]+$"}, "location_id": {"type": "string"}, "status": {"enum": ["DRAFT", "READY"]}, "layout": {"type": "object", "additionalProperties": false, "required": ["orientation", "scale", "zones", "entrances", "fixed_landmarks"], "properties": {"orientation": {"type": "string"}, "scale": {"type": "string"}, "zones": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "entrances": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "fixed_landmarks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}, "visual_language": {"type": "string"}, "base_palette_swatch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "continuity_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "camera_views": {"type": "array", "items": {"$ref": "#/$defs/camera"}}, "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}}, "prompt_template": {"type": "object", "additionalProperties": false, "required": ["positive", "negative"], "properties": {"positive": {"type": "string"}, "negative": {"type": "string"}}}, "human_review": {"$ref": "#/$defs/review"}}},
    "prop_state": {"type": "object", "additionalProperties": false, "required": ["id", "condition", "holder_character_id", "location_id", "status", "asset_id", "continuity_signature", "continuity_note"], "properties": {"id": {"type": "string", "pattern": "^PSTATE-[A-Z0-9-]+$"}, "condition": {"type": "string"}, "holder_character_id": {"type": ["string", "null"]}, "location_id": {"type": ["string", "null"]}, "status": {"enum": ["PLANNED", "GENERATED", "SELECTED", "REJECTED"]}, "asset_id": {"type": ["string", "null"]}, "continuity_signature": {"type": "string"}, "continuity_note": {"type": "string"}}},
    "prop": {"type": "object", "additionalProperties": false, "required": ["id", "prop_id", "status", "dimensions", "materials", "palette_swatch_ids", "distinctive_marks", "interaction_rules", "continuity_signature", "states", "default_state_id", "prompt_template", "human_review"], "properties": {"id": {"type": "string", "pattern": "^PDES-PROP-[A-Z0-9-]+$"}, "prop_id": {"type": "string"}, "status": {"enum": ["DRAFT", "READY"]}, "dimensions": {"type": "string"}, "materials": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "palette_swatch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "distinctive_marks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "interaction_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "continuity_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "states": {"type": "array", "items": {"$ref": "#/$defs/prop_state"}}, "default_state_id": {"type": ["string", "null"]}, "prompt_template": {"type": "object", "additionalProperties": false, "required": ["positive", "negative"], "properties": {"positive": {"type": "string"}, "negative": {"type": "string"}}}, "human_review": {"$ref": "#/$defs/review"}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["scene_id", "episode_id", "location_id", "location_variant_id", "weather", "time_of_day", "lighting", "prop_state_ids"], "properties": {"scene_id": {"type": "string"}, "episode_id": {"type": "string"}, "location_id": {"type": "string"}, "location_variant_id": {"type": ["string", "null"]}, "weather": {"type": "string"}, "time_of_day": {"type": "string"}, "lighting": {"type": "string"}, "prop_state_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
