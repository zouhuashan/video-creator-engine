{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-anime-project.schema.json",
  "title": "VideoCreator Novel Anime Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_type", "project_id", "title", "revision", "status",
    "created_at", "updated_at", "ip", "source_editions", "series", "seasons",
    "arcs", "episodes", "scenes", "shots", "assets", "renders", "human_review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_type": {"const": "NOVEL_ANIME_SERIES"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"$ref": "#/$defs/status"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "ip": {"$ref": "#/$defs/ip"},
    "source_editions": {"type": "array", "items": {"$ref": "#/$defs/source_edition"}},
    "series": {"$ref": "#/$defs/series"},
    "seasons": {"type": "array", "items": {"$ref": "#/$defs/season"}},
    "arcs": {"type": "array", "items": {"$ref": "#/$defs/arc"}},
    "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "renders": {"type": "array", "items": {"$ref": "#/$defs/render"}},
    "human_review": {"$ref": "#/$defs/human_review"}
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "DRAFT", "SOURCE_READY", "BIBLE_READY", "WRITING_READY", "STORYBOARD_READY",
        "ASSETS_READY", "AUDIO_READY", "ANIMATIC_READY", "MOTION_READY", "EDIT_READY",
        "QC_READY", "HUMAN_APPROVED", "PACKAGED"
      ]
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "reviewed_at", "reviewed_by"],
      "properties": {
        "required": {"const": true},
        "status": {"type": "string", "enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_by": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "common": {
      "type": "object",
      "required": ["id", "title", "revision", "status", "input_refs", "source_refs", "provider", "human_review"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"$ref": "#/$defs/status"},
        "input_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "provider": {"type": ["string", "null"], "maxLength": 200},
        "human_review": {"$ref": "#/$defs/human_review"}
      }
    },
    "ip": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "revision", "status", "input_refs", "source_refs", "provider", "human_review", "source_edition_ids", "series_ids", "publication_allowed"],
          "properties": {
            "id": {"type": "string", "pattern": "^IP-[A-Z0-9]{2,12}$"},
            "title": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1},
            "status": {"$ref": "#/$defs/status"},
            "input_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "provider": {"type": ["string", "null"]},
            "human_review": {"$ref": "#/$defs/human_review"},
            "source_edition_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9]{2,12}-[0-9]{3}$"}, "uniqueItems": true},
            "series_ids": {"type": "array", "items": {"type": "string", "pattern": "^SER-[A-Z0-9]{2,12}-[0-9]{2}$"}, "minItems": 1, "uniqueItems": true},
            "publication_allowed": {"const": false}
          }
        }
      ]
    },
    "source_edition": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "edition_label", "source_url", "rights_status", "chapter_ids"],
          "properties": {
            "id": {"type": "string", "pattern": "^SRC-[A-Z0-9]{2,12}-[0-9]{3}$"},
            "edition_label": {"type": "string", "minLength": 1},
            "source_url": {"type": "string", "format": "uri"},
            "rights_status": {"type": "string", "enum": ["UNKNOWN", "PUBLIC_DOMAIN_VERIFIED", "LICENSED"]},
            "chapter_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      ]
    },
    "series": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "ip_id", "season_ids"],
          "properties": {
            "id": {"type": "string", "pattern": "^SER-[A-Z0-9]{2,12}-[0-9]{2}$"},
            "ip_id": {"type": "string", "pattern": "^IP-[A-Z0-9]{2,12}$"},
            "season_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}$"}, "uniqueItems": true}
          }
        }
      ]
    },
    "season": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "series_id", "season_number", "arc_ids", "episode_ids"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
            "series_id": {"type": "string", "pattern": "^SER-[A-Z0-9]{2,12}-[0-9]{2}$"},
            "season_number": {"type": "integer", "minimum": 1, "maximum": 99},
            "arc_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}-ARC[0-9]{2}$"}, "uniqueItems": true},
            "episode_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}$"}, "uniqueItems": true}
          }
        }
      ]
    },
    "arc": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "season_id", "episode_ids"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2}-ARC[0-9]{2}$"},
            "season_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
            "episode_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}$"}, "uniqueItems": true}
          }
        }
      ]
    },
    "episode": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "season_id", "arc_id", "episode_number", "target_duration_seconds", "scene_ids", "continuity_in_ref", "continuity_delta_ref"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}$"},
            "season_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
            "arc_id": {"type": ["string", "null"], "pattern": "^S[0-9]{2}-ARC[0-9]{2}$"},
            "episode_number": {"type": "integer", "minimum": 1, "maximum": 999},
            "target_duration_seconds": {"type": "number", "minimum": 30, "maximum": 180},
            "scene_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}-SC[0-9]{3}$"}, "uniqueItems": true},
            "continuity_in_ref": {"type": ["string", "null"]},
            "continuity_delta_ref": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "scene": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "episode_id", "scene_number", "location_ref", "character_refs", "shot_ids"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}-SC[0-9]{3}$"},
            "episode_id": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}$"},
            "scene_number": {"type": "integer", "minimum": 1, "maximum": 999},
            "location_ref": {"type": ["string", "null"]},
            "character_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "shot_ids": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}-SC[0-9]{3}-SH[0-9]{3}$"}, "uniqueItems": true}
          }
        }
      ]
    },
    "shot": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "scene_id", "shot_number", "duration_seconds", "asset_refs", "render_strategy"],
          "properties": {
            "id": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}-SC[0-9]{3}-SH[0-9]{3}$"},
            "scene_id": {"type": "string", "pattern": "^S[0-9]{2}E[0-9]{3}-SC[0-9]{3}$"},
            "shot_number": {"type": "integer", "minimum": 1, "maximum": 999},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
            "asset_refs": {"type": "array", "items": {"type": "string", "pattern": "^AST-[A-Z0-9][A-Z0-9-]{2,80}$"}, "uniqueItems": true},
            "render_strategy": {"type": "string", "enum": ["local_animatic", "image_to_video", "keyframe_to_video", "lip_sync", "template_motion", "manual_import"]}
          }
        }
      ]
    },
    "asset": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "asset_type", "version", "path", "checksum"],
          "properties": {
            "id": {"type": "string", "pattern": "^AST-[A-Z0-9][A-Z0-9-]{2,80}$"},
            "asset_type": {"type": "string", "enum": ["character", "costume", "location", "prop", "keyframe", "audio", "music", "sfx", "subtitle", "video"]},
            "version": {"type": "integer", "minimum": 1},
            "path": {"type": "string", "minLength": 1},
            "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "render": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["id", "target_id", "asset_refs", "model", "parameters", "cost", "output_path"],
          "properties": {
            "id": {"type": "string", "pattern": "^RND-[A-Z0-9][A-Z0-9-]{2,80}$"},
            "target_id": {"type": "string"},
            "asset_refs": {"type": "array", "items": {"type": "string", "pattern": "^AST-[A-Z0-9][A-Z0-9-]{2,80}$"}, "uniqueItems": true},
            "model": {"type": ["string", "null"]},
            "parameters": {"type": "object"},
            "cost": {"type": "number", "minimum": 0},
            "output_path": {"type": ["string", "null"]}
          }
        }
      ]
    }
  }
}
