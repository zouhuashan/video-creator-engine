{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-shot-breakdown.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "script_revision", "asset_review_revision", "revision", "created_at", "updated_at", "scene_breakdowns"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "script_revision": {"type": "integer", "minimum": 1}, "asset_review_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "scene_breakdowns": {"type": "array", "items": {"$ref": "#/$defs/scene"}}},
  "$defs": {
    "review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "reviewed_at", "reviewed_by", "note"], "properties": {"required": {"const": true}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["location_id", "character_ids", "prop_state_ids", "emotion", "continuity_signature"], "properties": {"location_id": {"type": ["string", "null"]}, "character_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "prop_state_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "emotion": {"type": "string"}, "continuity_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "shot": {"type": "object", "additionalProperties": false, "required": ["id", "sequence", "shot_type", "framing", "angle", "movement", "lens", "duration_seconds", "start_state", "end_state", "reference_ids", "continuity_signature", "human_review"], "properties": {"id": {"type": "string", "pattern": "^SHOT-S[0-9]{2}E[0-9]{3}-SC[0-9]{3}-[0-9]{3}$"}, "sequence": {"type": "integer", "minimum": 1}, "shot_type": {"enum": ["ESTABLISHING", "WIDE", "MEDIUM", "CLOSEUP", "INSERT", "POV", "OVER_SHOULDER"]}, "framing": {"type": "string"}, "angle": {"type": "string"}, "movement": {"type": "string"}, "lens": {"type": "string"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "start_state": {"$ref": "#/$defs/state"}, "end_state": {"$ref": "#/$defs/state"}, "reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "continuity_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "human_review": {"$ref": "#/$defs/review"}}},
    "scene": {"type": "object", "additionalProperties": false, "required": ["scene_id", "episode_id", "location_id", "shot_ids", "shots", "human_review"], "properties": {"scene_id": {"type": "string"}, "episode_id": {"type": "string"}, "location_id": {"type": ["string", "null"]}, "shot_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}}, "human_review": {"$ref": "#/$defs/review"}}}
  }
}
