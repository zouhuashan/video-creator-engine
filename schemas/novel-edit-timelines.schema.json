{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-edit-timelines.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "dynamic_revision", "audio_mix_revision", "revision", "created_at", "updated_at", "episodes", "rerender_jobs"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "dynamic_revision": {"type": "integer", "minimum": 1}, "audio_mix_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}}, "rerender_jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}}},
  "$defs": {"review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "reviewed_at", "reviewed_by", "note"], "properties": {"required": {"const": true}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}}}, "clip": {"type": "object", "additionalProperties": false, "required": ["id", "shot_id", "source_kind", "source_path", "start_seconds", "end_seconds", "transition_in", "transition_out", "color_grade", "effect_ids"], "properties": {"id": {"type": "string", "pattern": "^CLIP-[A-Z0-9-]+$"}, "shot_id": {"type": "string"}, "source_kind": {"enum": ["DYNAMIC", "ANIMATIC", "MANUAL"]}, "source_path": {"type": ["string", "null"]}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}, "transition_in": {"type": "string"}, "transition_out": {"type": "string"}, "color_grade": {"type": "string"}, "effect_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}, "episode": {"type": "object", "additionalProperties": false, "required": ["episode_id", "clips", "dialogue_line_ids", "cue_ids", "subtitle_status", "audio_buses", "output_path", "status", "human_review"], "properties": {"episode_id": {"type": "string"}, "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}}, "dialogue_line_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "cue_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "subtitle_status": {"enum": ["PLANNED", "READY"]}, "audio_buses": {"type": "array", "uniqueItems": true, "items": {"enum": ["DIALOGUE", "MUSIC", "AMBIENCE", "SFX"]}}, "output_path": {"type": ["string", "null"]}, "status": {"enum": ["DRAFT", "READY"]}, "human_review": {"$ref": "#/$defs/review"}}}, "job": {"type": "object", "additionalProperties": false, "required": ["id", "episode_id", "shot_ids", "mode", "status", "input_revision", "output_path"], "properties": {"id": {"type": "string", "pattern": "^RENDERJOB-[A-Z0-9-]+$"}, "episode_id": {"type": "string"}, "shot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "mode": {"enum": ["REPLACE_CLIPS", "FULL_EPISODE"]}, "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]}, "input_revision": {"type": "integer", "minimum": 1}, "output_path": {"type": ["string", "null"]}}}
  }
}
