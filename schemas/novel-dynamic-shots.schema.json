{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videocreator.local/schemas/novel-dynamic-shots.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "ip_id", "storyboard_revision", "animatic_revision", "revision", "created_at", "updated_at", "shot_routes", "jobs", "budget", "reviews"],
  "properties": {"schema_version": {"const": 1}, "project_id": {"type": "string"}, "ip_id": {"type": "string"}, "storyboard_revision": {"type": "integer", "minimum": 1}, "animatic_revision": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "shot_routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}, "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}}, "budget": {"$ref": "#/$defs/budget"}, "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}}},
  "$defs": {"route": {"type": "object", "additionalProperties": false, "required": ["shot_id", "mode", "provider", "input_reference_ids", "fallback_mode", "prompt", "status"], "properties": {"shot_id": {"type": "string"}, "mode": {"enum": ["LOCAL_KEN_BURNS", "IMAGE_TO_VIDEO", "FIRST_LAST_FRAME", "LIP_SYNC", "MANUAL_IMPORT"]}, "provider": {"type": "string"}, "input_reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "fallback_mode": {"enum": ["LOCAL_KEN_BURNS", "MANUAL_IMPORT", "NONE"]}, "prompt": {"type": "string"}, "status": {"enum": ["DRAFT", "READY"]}}}, "job": {"type": "object", "additionalProperties": false, "required": ["id", "shot_id", "provider", "billable", "confirm_billable", "upload_authorized", "status", "retry_count", "max_retries", "output_path"], "properties": {"id": {"type": "string", "pattern": "^DYNJOB-[A-Z0-9-]+$"}, "shot_id": {"type": "string"}, "provider": {"type": "string"}, "billable": {"type": "boolean"}, "confirm_billable": {"type": "boolean"}, "upload_authorized": {"type": "boolean"}, "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]}, "retry_count": {"type": "integer", "minimum": 0}, "max_retries": {"type": "integer", "minimum": 0}, "output_path": {"type": ["string", "null"]}}}, "budget": {"type": "object", "additionalProperties": false, "required": ["currency", "limit", "reserved", "spent"], "properties": {"currency": {"const": "USD"}, "limit": {"type": "number", "minimum": 0}, "reserved": {"type": "number", "minimum": 0}, "spent": {"type": "number", "minimum": 0}}}, "review": {"type": "object", "additionalProperties": false, "required": ["shot_id", "status", "reviewed_at", "reviewed_by", "note", "identity_pass", "motion_pass"], "properties": {"shot_id": {"type": "string"}, "status": {"enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED"]}, "reviewed_at": {"type": ["string", "null"]}, "reviewed_by": {"type": ["string", "null"]}, "note": {"type": "string"}, "identity_pass": {"type": "boolean"}, "motion_pass": {"type": "boolean"}}}
  }
}
